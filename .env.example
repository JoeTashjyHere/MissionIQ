# ─────────────────────────────────────────────────────────────────────────────
# MissionIQ — Environment Variables (copy to .env for local dev)
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
MIQ_ENV=development
MIQ_LOG_LEVEL=INFO
MIQ_BACKEND_HOST=0.0.0.0
MIQ_BACKEND_PORT=8000
MIQ_FRONTEND_ORIGIN=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────────────
# Used by both backend container and host-side Alembic.
POSTGRES_USER=missioniq
POSTGRES_PASSWORD=missioniq_dev_password
POSTGRES_DB=missioniq
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
MIQ_DATABASE_URL=postgresql+asyncpg://missioniq:missioniq_dev_password@postgres:5432/missioniq
MIQ_DATABASE_URL_SYNC=postgresql+psycopg://missioniq:missioniq_dev_password@postgres:5432/missioniq

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
MIQ_JWT_SECRET=change-me-to-a-long-random-string-for-local-dev-only
MIQ_JWT_ALGORITHM=HS256
MIQ_ACCESS_TOKEN_TTL_MINUTES=30
MIQ_REFRESH_TOKEN_TTL_DAYS=14

# ── Storage (BlobStore) ──────────────────────────────────────────────────────
MIQ_BLOB_STORE=local              # local | s3
MIQ_BLOB_LOCAL_ROOT=/app/var/blobs
# S3 (future)
# MIQ_S3_BUCKET=
# MIQ_S3_REGION=
# MIQ_S3_PREFIX=missioniq/

# ── LLM Provider Routing ─────────────────────────────────────────────────────
# Comma-separated, in fallback order. First available provider with credentials wins.
# Options: openai, anthropic, bedrock, azure_openai, local_stub
MIQ_LLM_PROVIDER_ORDER=local_stub,openai,anthropic
MIQ_LLM_DEFAULT_MODEL=auto        # 'auto' picks provider default
MIQ_EMBEDDING_PROVIDER=local_stub # local_stub | openai | bedrock | azure_openai
MIQ_EMBEDDING_DIM=1536

# Compliance acknowledgement — must be 'true' for the platform to start
# when using providers that have training opt-out concerns (OpenAI).
MIQ_OPENAI_TRAINING_OPT_OUT_ACK=true

# OpenAI
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-latest

# AWS Bedrock
AWS_BEDROCK_REGION=us-east-1
AWS_BEDROCK_DEFAULT_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
AWS_BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# ── Market Intelligence: SAM.gov ─────────────────────────────────────────────
# Get a free key at https://sam.gov/data-services
SAM_GOV_API_KEY=
SAM_GOV_BASE_URL=https://api.sam.gov

# ── Upload limits ────────────────────────────────────────────────────────────
MIQ_MAX_UPLOAD_BYTES=52428800     # 50 MB
MIQ_WORKSPACE_STORAGE_QUOTA_BYTES=5368709120  # 5 GB
